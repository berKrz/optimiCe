# CC is left to make's default (cc): override it with `make CC=clang` or from the environment
PKG_CONFIG ?= pkg-config

# tomlc17 ships a pkg-config file (libtomlc17.pc). Fall back to a bare -ltomlc17
# when pkg-config is missing or can't find it (library on a default search path)
TOML_CFLAGS := $(shell $(PKG_CONFIG) --cflags libtomlc17 2>/dev/null)
TOML_LIBS   := $(shell $(PKG_CONFIG) --libs   libtomlc17 2>/dev/null || echo -ltomlc17)

# CFLAGS is the part meant to be overridden (`make CFLAGS="-O0 -g"`); BUILD_FLAGS is what the
# build needs whatever CFLAGS says
CFLAGS      ?= -O2 -g -Wall -Wextra
# Calling an undeclared function is an error, not a warning: it's what keeps a file from using
# anything outside the headers it includes
BUILD_FLAGS  = -std=c11 -pthread -I$(SRCDIR) -I$(BUILDDIR) -D_GNU_SOURCE -MMD -MP \
               -finput-charset=UTF-8 -fexec-charset=UTF-8 \
               -Werror=implicit-function-declaration $(TOML_CFLAGS)
LDLIBS       = -lm $(TOML_LIBS)

# Everything the build produces goes under BUILDDIR, mirroring SRCDIR: objects, dependency files
# and the two generated headers. Only the binary lands outside it, at the top
TARGET   = optimice
SRCDIR   = src
BUILDDIR = build

# Every .c file in src/ and its directories is built: a new source needs no entry here
# An algorithm is one file, src/algorithms/<name>.c, defining `<name>_algorithm`. ALGOS is the
# list of those names, sorted so the generated registry doesn't depend on directory order
SRC      := $(sort $(wildcard $(SRCDIR)/*.c $(SRCDIR)/*/*.c))
ALGO_SRC := $(sort $(wildcard $(SRCDIR)/algorithms/*.c))
ALGOS    := $(notdir $(basename $(ALGO_SRC)))
OBJ       = $(SRC:$(SRCDIR)/%.c=$(BUILDDIR)/%.o)

# Unit tests link against a second build of the program's objects, under UNITTEST_DIR, made with
# OPTIMICE_UNITTEST defined: there, functions marked UNITTEST aren't static
UNITTEST_DIR = $(BUILDDIR)/unittest

# Algorithms only read g_cfg and g_opts: this makes naming their writable versions an error there
$(ALGO_SRC:$(SRCDIR)/%.c=$(BUILDDIR)/%.o) $(ALGO_SRC:$(SRCDIR)/%.c=$(UNITTEST_DIR)/%.o): \
  BUILD_FLAGS += -DOPTIMICE_ALGORITHM_FILE

# Development tools, each one file in tools/ linked against every object but main.o: they reuse the
# program's tables and printers without being part of it
TOOLDIR   = tools
TOOL_SRC := $(sort $(wildcard $(TOOLDIR)/*.c))
TOOLS     = $(TOOL_SRC:$(TOOLDIR)/%.c=$(BUILDDIR)/$(TOOLDIR)/%)
LIB_OBJ   = $(filter-out $(BUILDDIR)/main.o,$(OBJ))

# Unit tests, written with Criterion: every .c file in tests/unit/ is linked into one binary, with
# the UNITTEST build of every object but main.o
TESTDIR      = tests
UNIT_SRC    := $(sort $(wildcard $(TESTDIR)/unit/*.c))
UNIT_OBJ     = $(UNIT_SRC:%.c=$(BUILDDIR)/%.o)
UNIT_BIN     = $(BUILDDIR)/$(TESTDIR)/unit-tests
UNITTEST_OBJ = $(LIB_OBJ:$(BUILDDIR)/%=$(UNITTEST_DIR)/%)

# End-to-end tests: shell scripts run against the built program
CLI_TESTS := $(sort $(wildcard $(TESTDIR)/cli/test-*.sh))

CRITERION_CFLAGS := $(shell $(PKG_CONFIG) --cflags criterion 2>/dev/null)
CRITERION_LIBS   := $(shell $(PKG_CONFIG) --libs   criterion 2>/dev/null || echo -lcriterion)

$(UNITTEST_OBJ) $(UNIT_OBJ): BUILD_FLAGS += -DOPTIMICE_UNITTEST
$(UNIT_OBJ): BUILD_FLAGS += $(CRITERION_CFLAGS)

DEP       = $(OBJ:.o=.d) $(TOOLS:=.d) $(UNITTEST_OBJ:.o=.d) $(UNIT_OBJ:.o=.d)

# Every doc gen-docs may have blocks in; it leaves a doc without blocks unchanged
DOCS     := $(wildcard README.md CONTRIBUTING.md docs/*.md docs/algorithms/*.md)

# Commit the binary was built from, for the results file's header: the short hash, plus "-dirty"
# when the tree had uncommitted changes (a git tag instead, once one exists)
# The flake passes it in, since a Nix build has no .git
VERSION ?= $(shell git describe --always --dirty 2>/dev/null || echo unknown)

all: $(TARGET)

# The two generated headers are regenerated on every make, but only rewritten when their content
# changed, so what includes them is rebuilt exactly when it has to be
define replace_if_changed
	@if cmp -s $@.tmp $@; then rm $@.tmp; else mv $@.tmp $@; fi
endef

# Changes with the commit (or its dirty state)
$(BUILDDIR)/version.h: FORCE
	@mkdir -p $(@D)
	@printf '#define OPTIMICE_VERSION "%s"\n' '$(VERSION)' > $@.tmp
	$(replace_if_changed)

# Changes when a file is added to or removed from src/algorithms/: one extern per algorithm, then
# the array of them, for registry.c
$(BUILDDIR)/registry.h: FORCE
	@mkdir -p $(@D)
	@{ printf '// Generated by the Makefile from $(SRCDIR)/algorithms/*.c\n'; \
	   $(foreach a,$(ALGOS),printf 'extern const Algorithm $(a)_algorithm;\n';) \
	   printf 'const Algorithm* const algorithms[] = {\n'; \
	   $(foreach a,$(ALGOS),printf '    &$(a)_algorithm,\n';) \
	   printf '    NULL,\n};\n'; } > $@.tmp
	$(replace_if_changed)

# Changes when a UNITTEST prototype is added, removed or edited: every one in src/, for the tests
# Includes what those prototypes may use: the public headers, re-exported so a test includes only
# this one, and the standard headers of the types they take (FILE, struct tm)
$(BUILDDIR)/unittest.h: FORCE
	@mkdir -p $(@D)
	@{ printf '// Generated by the Makefile from the UNITTEST prototypes in $(SRCDIR)/\n'; \
	   printf '#pragma once\n\n#include <stdio.h>\n#include <time.h>\n\n'; \
	   for h in algorithms/algorithm.h config/config.h core/core.h io/io.h; do \
	     printf '#include "%s"  // IWYU pragma: export\n' $$h; done; \
	   printf '\n'; \
	   sed -n '/^UNITTEST .*;$$/p' $(SRC); } > $@.tmp
	$(replace_if_changed)

# Listed explicitly: on a first build there are no .d files yet to say who includes what
$(BUILDDIR)/io/output.o $(UNITTEST_DIR)/io/output.o: $(BUILDDIR)/version.h
$(BUILDDIR)/core/registry.o $(UNITTEST_DIR)/core/registry.o: $(BUILDDIR)/registry.h
$(UNIT_OBJ): $(BUILDDIR)/unittest.h

$(TARGET): $(OBJ)
	$(CC) $(BUILD_FLAGS) $(CFLAGS) -o $@ $^ $(LDLIBS)

$(BUILDDIR)/%.o: $(SRCDIR)/%.c
	@mkdir -p $(@D)
	$(CC) $(BUILD_FLAGS) $(CFLAGS) -c -o $@ $<

$(BUILDDIR)/$(TOOLDIR)/%.o: $(TOOLDIR)/%.c
	@mkdir -p $(@D)
	$(CC) $(BUILD_FLAGS) $(CFLAGS) -c -o $@ $<

$(BUILDDIR)/$(TOOLDIR)/%: $(BUILDDIR)/$(TOOLDIR)/%.o $(LIB_OBJ)
	$(CC) $(BUILD_FLAGS) $(CFLAGS) -o $@ $^ $(LDLIBS)

$(UNITTEST_DIR)/%.o: $(SRCDIR)/%.c
	@mkdir -p $(@D)
	$(CC) $(BUILD_FLAGS) $(CFLAGS) -c -o $@ $<

$(BUILDDIR)/$(TESTDIR)/%.o: $(TESTDIR)/%.c
	@mkdir -p $(@D)
	$(CC) $(BUILD_FLAGS) $(CFLAGS) -c -o $@ $<

$(UNIT_BIN): $(UNIT_OBJ) $(UNITTEST_OBJ)
	$(CC) $(BUILD_FLAGS) $(CFLAGS) -o $@ $^ $(LDLIBS) $(CRITERION_LIBS)

# Regenerates the blocks in every doc; run from the repository root, since links are worked out
# from the docs' paths
docs: $(BUILDDIR)/$(TOOLDIR)/gen-docs
	$< $(DOCS)

# Runs every test
test: test-unit test-cli

# Every algorithm brings its own tests, unit and shell, named after its source file: both test
# targets check this first, before building anything, so a missing file is reported as such
ALGO_NAMES = $(notdir $(basename $(ALGO_SRC)))

check-tests:
	@status=0; for name in $(ALGO_NAMES); do \
	  for f in $(TESTDIR)/unit/test-$$name.c $(TESTDIR)/cli/test-$$name.sh; do \
	    [ -f "$$f" ] || { echo "Error: algorithm '$$name' needs its tests at $$f" >&2; status=1; }; \
	  done; \
	done; exit $$status

test-unit: check-tests $(UNIT_BIN)
	$(UNIT_BIN)

# Every tests/cli/test-*.sh, each running the program as a user would; all run even after a failure
test-cli: check-tests $(TARGET)
	@status=0; for t in $(CLI_TESTS); do \
	  echo "# $$t"; OPTIMICE=$(CURDIR)/$(TARGET) sh $$t || status=1; \
	done; exit $$status

clean:
	rm -rf $(BUILDDIR) $(TARGET)

-include $(DEP)

.PHONY: all clean docs test test-unit test-cli check-tests FORCE
