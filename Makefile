# CC is left to make's default (cc): override it with `make CC=clang` or from the environment
PKG_CONFIG ?= pkg-config

# tomlc17 ships a pkg-config file (libtomlc17.pc). Fall back to a bare -ltomlc17
# when pkg-config is missing or can't find it (library on a default search path)
TOML_CFLAGS := $(shell $(PKG_CONFIG) --cflags libtomlc17 2>/dev/null)
TOML_LIBS   := $(shell $(PKG_CONFIG) --libs   libtomlc17 2>/dev/null || echo -ltomlc17)

# CFLAGS is the part meant to be overridden (`make CFLAGS="-O0 -g"`); BUILD_FLAGS is what the
# build needs whatever CFLAGS says
CFLAGS      ?= -O2 -g -Wall -Wextra
BUILD_FLAGS  = -std=c11 -pthread -I$(SRCDIR) -D_GNU_SOURCE -MMD -MP \
               -finput-charset=UTF-8 -fexec-charset=UTF-8 $(TOML_CFLAGS)
LDLIBS       = -lm $(TOML_LIBS)

TARGET = optimice
SRCDIR = src

# Every .c file is built: a new source needs no entry here
# An algorithm is one file, src/algorithms/<name>.c, defining `<name>_algorithm`. ALGOS is the
# list of those names, sorted so the generated registry doesn't depend on directory order
ALGO_SRC := $(sort $(wildcard $(SRCDIR)/algorithms/*.c))
ALGOS    := $(notdir $(basename $(ALGO_SRC)))
SRC      := $(sort $(wildcard $(SRCDIR)/*.c)) $(ALGO_SRC)
OBJ       = $(SRC:.c=.o)
DEP       = $(OBJ:.o=.d)

# Commit the binary was built from, for the results file's header: the short hash, plus "-dirty"
# when the tree had uncommitted changes (a git tag instead, once one exists)
# The flake passes it in, since a Nix build has no .git
VERSION ?= $(shell git describe --always --dirty 2>/dev/null || echo unknown)

all: $(TARGET)

# The two generated headers are regenerated on every make, but only rewritten when their content
# changed, so what includes them is rebuilt exactly when it has to be
define replace_if_changed
	@if cmp -s $@.tmp $@; then rm $@.tmp; else mv $@.tmp $@; fi
endef

# Changes with the commit (or its dirty state)
$(SRCDIR)/version.h: FORCE
	@printf '#define OPTIMICE_VERSION "%s"\n' '$(VERSION)' > $@.tmp
	$(replace_if_changed)

# Changes when a file is added to or removed from src/algorithms/: one extern per algorithm, then
# the array of them, for registry.c
$(SRCDIR)/registry.h: FORCE
	@{ printf '// Generated by the Makefile from $(SRCDIR)/algorithms/*.c\n'; \
	   $(foreach a,$(ALGOS),printf 'extern const Algorithm $(a)_algorithm;\n';) \
	   printf 'const Algorithm* const algorithms[] = {\n'; \
	   $(foreach a,$(ALGOS),printf '    &$(a)_algorithm,\n';) \
	   printf '    NULL,\n};\n'; } > $@.tmp
	$(replace_if_changed)

# Listed explicitly: on a first build there are no .d files yet to say who includes what
$(SRCDIR)/output.o: $(SRCDIR)/version.h
$(SRCDIR)/registry.o: $(SRCDIR)/registry.h

$(TARGET): $(OBJ)
	$(CC) $(BUILD_FLAGS) $(CFLAGS) -o $@ $^ $(LDLIBS)

%.o: %.c
	$(CC) $(BUILD_FLAGS) $(CFLAGS) -c -o $@ $<

clean:
	rm -f $(OBJ) $(DEP) $(TARGET) $(SRCDIR)/version.h $(SRCDIR)/registry.h

-include $(DEP)

.PHONY: all clean FORCE
